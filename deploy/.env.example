# =============================================================================
# Varistha Environment Variables
# Copy this file to .env and fill in values before running docker compose
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=varistha
POSTGRES_USER=varistha
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ---- API ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production_generate_with_python
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ---- LLM Gateway (LiteLLM) ----
# At least one provider key is required for agents to run.
# Varistha supports any provider LiteLLM supports.
LITELLM_API_KEY=
# Optional: point to a local Ollama instance
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- UI ----
UI_PORT=3000
# Must be the URL the browser can reach the API at
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Optional model provider keys (set as needed) ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# ---- Telemetry & Observability Fan-Out (optional) ----
# Set to enable OpenTelemetry export to collector (e.g. http://otel-collector:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varistha

# ---- External Observability Fan-Out Backends (used by otel profile) ----
# Langfuse integration (cloud or self-hosted)
# Generate Basic Auth header: echo -n "pk-lf-...:sk-lf-..." | base64
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_AUTH_HEADER=

# Grafana Tempo / SigNoz integration (gRPC)
TEMPO_OTLP_ENDPOINT=tempo:4317


# ---- Auth ----
# JWT secret for Better Auth — generate with: openssl rand -base64 32
AUTH_SECRET=change_me_in_production
