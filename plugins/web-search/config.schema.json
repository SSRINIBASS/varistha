{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebSearchPluginConfig",
  "type": "object",
  "properties": {
    "engine": {
      "type": "string",
      "enum": ["duckduckgo", "searxng", "mock"],
      "default": "duckduckgo",
      "description": "Search provider engine to query"
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5,
      "description": "Maximum number of search results to retrieve"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 30.0,
      "default": 10.0,
      "description": "Network request timeout in seconds"
    }
  },
  "additionalProperties": false
}
